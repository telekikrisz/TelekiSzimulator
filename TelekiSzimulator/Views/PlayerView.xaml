<UserControl x:Class="TelekiSzimulator.Views.PlayerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xml:lang="hu-HU"
             Background="#EEF1F4"
             FontFamily="Segoe UI"
             FontSize="15">
    <Grid Margin="24">
        <StackPanel x:Name="Picker" Width="440" VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="Játék" FontSize="32" FontWeight="SemiBold" HorizontalAlignment="Center"/>
            <TextBlock Text="Válassz történetet. Indítás után ezen a körön már nem lehet másikat választani."
                       Margin="0,8,0,16"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       Foreground="#4B5563"/>
            <ComboBox x:Name="StoryCombo"
                      MinHeight="36"
                      SelectionChanged="StoryCombo_SelectionChanged"/>
            <TextBlock x:Name="PickerStatus"
                       Margin="0,10,0,0"
                       TextWrapping="Wrap"
                       Foreground="#6B7280"
                       HorizontalAlignment="Center"/>
            <Button Content="Bezárás"
                    Margin="0,18,0,0"
                    Padding="14,6"
                    HorizontalAlignment="Center"
                    Click="Close_Click"/>
        </StackPanel>

        <Grid x:Name="Stage" Visibility="Collapsed">
            <Button Content="Bezárás"
                    Padding="14,6"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Click="Close_Click"/>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel MaxWidth="860" Margin="0,48,0,24" HorizontalAlignment="Center">
                    <TextBlock x:Name="StoryHeading"
                               FontSize="16"
                               Foreground="#6B7280"
                               TextAlignment="Center"
                               Margin="0,0,0,12"/>
                    <Border Background="#111827" CornerRadius="8" Width="720" Height="405" HorizontalAlignment="Center">
                        <Grid>
                            <MediaElement x:Name="Player"
                                          LoadedBehavior="Manual"
                                          UnloadedBehavior="Manual"
                                          Stretch="Uniform"
                                          ScrubbingEnabled="True"
                                          Visibility="Collapsed"
                                          MediaEnded="Player_MediaEnded"
                                          MediaFailed="Player_MediaFailed"/>
                            <Image x:Name="Still"
                                   Stretch="Uniform"
                                   Visibility="Collapsed"/>
                            <TextBlock x:Name="MediaNote"
                                       Text="Nincs média."
                                       Foreground="#D1D5DB"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Margin="24"/>
                        </Grid>
                    </Border>
                    <TextBlock x:Name="SceneTitle"
                               FontSize="28"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Margin="0,20,0,0"/>
                    <TextBlock x:Name="SceneText"
                               FontSize="18"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               LineHeight="28"
                               Margin="0,12,0,24"/>
                    <StackPanel x:Name="ChoiceButtons" Orientation="Horizontal" HorizontalAlignment="Center"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
