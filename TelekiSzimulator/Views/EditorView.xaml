<UserControl x:Class="TelekiSzimulator.Views.EditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             xml:lang="hu-HU"
             Background="#EEF1F4"
             FontFamily="Segoe UI"
             FontSize="15">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="16,12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Mentett történetek" VerticalAlignment="Center"/>
                <ComboBox x:Name="StoryCombo"
                          Grid.Column="1"
                          Margin="8,0,0,0"
                          MinHeight="34"
                          VerticalContentAlignment="Center"
                          SelectionChanged="StoryCombo_SelectionChanged"/>
                <TextBlock Grid.Column="3" Text="Történet neve" VerticalAlignment="Center"/>
                <TextBox x:Name="StoryNameBox"
                         Grid.Column="4"
                         Margin="8,0,0,0"
                         MinHeight="34"
                         Padding="8,4"
                         VerticalContentAlignment="Center"
                         LostFocus="StoryNameBox_LostFocus"/>
                <Button Grid.Column="6"
                        Content="Új történet"
                        Padding="14,6"
                        Margin="0,0,8,0"
                        Click="NewStory_Click"/>
                <Button Grid.Column="7"
                        Content="Bezárás"
                        Padding="14,6"
                        Click="Close_Click"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="400"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="12" Margin="0,0,12,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                        <Button x:Name="NewSceneButton"
                                Content="Új jelenet"
                                Padding="8,8"
                                Click="NewScene_Click"/>
                        <Button x:Name="DeleteSceneButton"
                                Content="Jelenet törlése"
                                Padding="8,8"
                                Margin="0,8,0,0"
                                IsEnabled="False"
                                Click="DeleteScene_Click"/>
                        <TextBlock Text="A csillag az egyetlen kezdőjelenet, a négyzet egy záró jelenet. A többi szint szerint rendezett."
                                   FontSize="12"
                                   Foreground="#6B7280"
                                   TextWrapping="Wrap"
                                   Margin="2,10,0,0"/>
                    </StackPanel>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top"
                                   Text="Jelenetek"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Margin="4,2,0,8"/>
                        <Grid>
                            <ListBox x:Name="SceneList"
                                     BorderThickness="0"
                                     HorizontalContentAlignment="Stretch"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     SelectionChanged="SceneList_SelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ListLabel}" TextWrapping="Wrap"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="8,7"/>
                                        <Setter Property="Margin" Value="0,1"/>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>
                            <TextBlock x:Name="EmptyListHint"
                                       Text="Még nincs mentett jelenet."
                                       Foreground="#9CA3AF"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"/>
                        </Grid>
                    </DockPanel>
                </DockPanel>
            </Border>

            <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="16" Margin="0,0,12,0">
                <Grid>
                    <TextBlock x:Name="FormPlaceholder"
                               Text="A bal oldali lista a mentett jeleneteké. Az Új jelenet gomb megnyitja ezt az adatlapot. Mentés után a jelenet megjelenik a listában, kattintásra pedig újra szerkeszthető."
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Foreground="#6B7280"
                               Margin="24"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"/>
                    <ScrollViewer x:Name="FormPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock x:Name="SceneIdText"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,14"/>

                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="88"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="Jelenet címe"/>
                                <TextBlock Grid.Column="1" Text="Szint" Margin="8,0,0,0"/>
                                <TextBox x:Name="SceneTitleBox"
                                         Grid.Row="1"
                                         MinHeight="34"
                                         Padding="8,4"
                                         Margin="0,4,0,0"
                                         VerticalContentAlignment="Center"
                                         TextChanged="FormField_Changed"/>
                                <TextBox x:Name="SceneLevelBox"
                                         Grid.Row="1"
                                         Grid.Column="1"
                                         MinHeight="34"
                                         Padding="8,4"
                                         Margin="8,4,0,0"
                                         VerticalContentAlignment="Center"
                                         TextChanged="FormField_Changed"/>
                                <CheckBox x:Name="EndingBox"
                                          Grid.Row="2"
                                          Content="Záró jelenet"
                                          Margin="0,10,0,0"
                                          Checked="EndingBox_Changed"
                                          Unchecked="EndingBox_Changed"/>
                            </Grid>

                            <TextBlock Text="Jelenet szövege"/>
                            <TextBox x:Name="SceneTextBox"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     MinHeight="110"
                                     Padding="8"
                                     Margin="0,4,0,14"
                                     VerticalScrollBarVisibility="Auto"
                                     TextChanged="FormField_Changed"/>

                            <TextBlock Text="Média"/>
                            <Grid Margin="0,4,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Background="#F3F4F6" CornerRadius="4" Padding="8,6" MinHeight="34">
                                    <TextBlock x:Name="MediaNameText"
                                               Text="Nincs média"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                </Border>
                                <Button Grid.Column="1"
                                        Content="Tallózás..."
                                        Margin="8,0,0,0"
                                        Padding="14,6"
                                        Click="Browse_Click"/>
                            </Grid>
                            <TextBlock Text="png vagy jpg kép, gif animáció, mp4 videó vagy mp3 hang. A program a jelenet számával menti, például 1.gif."
                                       Foreground="#6B7280"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,16"/>

                            <TextBlock Text="Választások" FontWeight="SemiBold"/>
                            <TextBlock Text="A felirat kerül a gombra. A cél egy már elmentett jelenet. Üres cél később is beállítható."
                                       Foreground="#6B7280"
                                       TextWrapping="Wrap"
                                       Margin="0,2,0,8"/>

                            <Grid x:Name="ChoiceHeader" Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="210"/>
                                    <ColumnDefinition Width="84"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Felirat" Foreground="#6B7280"/>
                                <TextBlock Grid.Column="1" Text="Céljelenet" Margin="8,0,0,0" Foreground="#6B7280"/>
                            </Grid>
                            <StackPanel x:Name="ChoicesPanel"/>
                            <TextBlock x:Name="EndingHint"
                                       Text="Választás nélkül a lejátszóban nincs tovább gomb. A záró jelenetet a jelölőnégyzet jelöli."
                                       TextWrapping="Wrap"
                                       Foreground="#6B7280"
                                       Margin="0,0,0,8"
                                       Visibility="Collapsed"/>
                            <Button Content="Új választás"
                                    HorizontalAlignment="Left"
                                    Padding="10,6"
                                    Margin="0,4,0,0"
                                    Click="AddChoice_Click"/>

                            <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                                <Button Content="Jelenet mentése"
                                        Padding="16,8"
                                        FontWeight="SemiBold"
                                        Click="SaveScene_Click"/>
                                <Button x:Name="SetStartButton"
                                        Content="Ez legyen a kezdőjelenet"
                                        Margin="8,0,0,0"
                                        Padding="12,8"
                                        Click="SetStart_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="White" CornerRadius="8" Padding="12">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="Média előnézet"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Margin="4,2,0,8"/>
                    <TextBlock x:Name="PreviewStatus"
                               DockPanel.Dock="Bottom"
                               Text="Nincs kiválasztott média."
                               TextWrapping="Wrap"
                               Foreground="#4B5563"
                               Margin="4,8,4,2"/>
                    <Border Background="#111827" CornerRadius="6">
                        <Grid>
                            <MediaElement x:Name="PreviewPlayer"
                                          LoadedBehavior="Manual"
                                          UnloadedBehavior="Manual"
                                          Stretch="Uniform"
                                          ScrubbingEnabled="True"
                                          Visibility="Collapsed"
                                          MediaEnded="PreviewPlayer_MediaEnded"
                                          MediaFailed="PreviewPlayer_MediaFailed"/>
                            <Image x:Name="PreviewImage"
                                   Stretch="Uniform"
                                   Visibility="Collapsed"/>
                            <TextBlock x:Name="PreviewPlaceholder"
                                       Text="Itt jelenik meg a kiválasztott média."
                                       Foreground="#D1D5DB"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Margin="20"/>
                        </Grid>
                    </Border>
                </DockPanel>
            </Border>
        </Grid>

        <TextBlock x:Name="StatusText"
                   Grid.Row="2"
                   Margin="4,10,4,0"
                   Foreground="#4B5563"
                   TextWrapping="Wrap"
                   Text="A történetek a projekt Stories mappájába kerülnek."/>
    </Grid>
</UserControl>
