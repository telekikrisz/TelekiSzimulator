<UserControl x:Class="TelekiSzimulator.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xml:lang="hu-HU"
             Background="Transparent"
             FontFamily="Segoe UI"
             FontSize="15">
    <Border Background="{StaticResource CardBrush}"
            CornerRadius="22"
            Padding="28,26"
            Width="400"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="0" Opacity="0.14" Color="#2C2416"/>
        </Border.Effect>
        <StackPanel>
            <Border Width="52" Height="8" CornerRadius="4" Background="{StaticResource AccentBrush}" HorizontalAlignment="Center" Margin="0,0,0,16"/>
            <TextBlock Text="Teleki szimulátor"
                       FontSize="28"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="Szerkeszd a történetet, vagy játszd végig."
                       Margin="0,8,0,0"
                       Foreground="{StaticResource MutedBrush}"
                       TextAlignment="Center"/>
            <Button Content="Szerkesztő"
                    Style="{StaticResource GreenButton}"
                    Height="52"
                    Margin="0,24,0,0"
                    FontSize="18"
                    Click="Editor_Click"/>
            <Button Content="Játék"
                    Style="{StaticResource PrimaryButton}"
                    Height="52"
                    Margin="0,12,0,0"
                    FontSize="18"
                    Click="Game_Click"/>
        </StackPanel>
    </Border>
</UserControl>
