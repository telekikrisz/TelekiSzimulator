<UserControl x:Class="TelekiSzimulator.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xml:lang="hu-HU"
             Background="#EEF1F4"
             FontFamily="Segoe UI"
             FontSize="15">
    <StackPanel Width="360" VerticalAlignment="Center" HorizontalAlignment="Center">
        <TextBlock Text="Teleki szimulátor"
                   FontSize="32"
                   FontWeight="SemiBold"
                   HorizontalAlignment="Center"/>
        <TextBlock Text="Szerkeszd a történetet, vagy játszd végig."
                   Margin="0,8,0,0"
                   Foreground="#4B5563"
                   HorizontalAlignment="Center"/>
        <Button Content="Szerkesztő"
                Height="56"
                Margin="0,28,0,0"
                FontSize="18"
                Click="Editor_Click"/>
        <Button Content="Játék"
                Height="56"
                Margin="0,12,0,0"
                FontSize="18"
                Click="Game_Click"/>
    </StackPanel>
</UserControl>
